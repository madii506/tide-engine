{
  "cleanUrls": true,
  "functions": {
    "api/launch.js": { "maxDuration": 60 },
    "api/tick.js": { "maxDuration": 60 },
    "api/data.js": { "maxDuration": 25 },
    "api/meta.js": { "maxDuration": 15 }
  },
  "crons": [{ "path": "/api/tick", "schedule": "* * * * *" }],
  "rewrites": [
    { "source": "/api/stats", "destination": "/api/data?op=stats" },
    { "source": "/api/coins", "destination": "/api/data?op=coins" },
    { "source": "/api/coin", "destination": "/api/data?op=coin" },
    { "source": "/api/ledger", "destination": "/api/data?op=ledger" },
    { "source": "/m/:id", "destination": "/api/meta?id=:id" },
    { "source": "/i/:id", "destination": "/api/meta?img=:id" }
  ],
  "headers": [
    { "source": "/assets/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/(css|js|img)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
  ]
}
